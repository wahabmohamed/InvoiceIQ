# Groq API - obtenir une cle gratuite sur https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# ChromaDB
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=invoices_e5_cosine

# Embeddings (multilingue ; changer de modele => changer de collection, re-indexation auto)
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Base de donnees
SQLITE_PATH=database/invoiceiq.db

# Upload
UPLOAD_DIR=data/uploads

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# RAG / extraction
RAG_TOP_K=5
RAG_MIN_SCORE=0.75
EXTRACTION_MAX_CHARS=12000
AMOUNT_TOLERANCE=0.02

# Frontend
VITE_API_URL=http://localhost:8000
